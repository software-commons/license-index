+import json,unittest
+from io import BytesIO
+from zipfile import ZipFile,ZIP_DEFLATED
+from tools.history_v2_gate import history_format
+OID='a'*40
+def archive(fmt, names, *, huge=False):
+ b=BytesIO();manifest={'format':fmt,'objects':{OID:{}}}
+ if huge:manifest['padding']='x'*(8*1024*1024)
+ with ZipFile(b,'w',compression=ZIP_DEFLATED) as z:
+  z.writestr('manifest.json',json.dumps(manifest))
+  for name in names:z.writestr(name,b'data')
+ return b.getvalue()
+class FormatTests(unittest.TestCase):
+ def test_valid_legacy_v1(self):self.assertEqual(history_format(archive('license-index-history-v1',['objects/'+OID])),'license-index-history-v1')
+ def test_valid_v2(self):self.assertEqual(history_format(archive('license-index-history-v2',['objects.zlib'])),'license-index-history-v2')
+ def test_format_confusion_rejected(self):
+  for fmt,names in [('license-index-history-v1',['objects.zlib']),('license-index-history-v2',['objects/'+OID]),('license-index-history-v2',[]),('license-index-history-v1',[]),('unknown',['objects.zlib'])]:
+   with self.subTest(fmt=fmt,names=names),self.assertRaises(ValueError):history_format(archive(fmt,names))
+ def test_duplicate_and_extra_rejected(self):
+  for fmt,names in [('license-index-history-v1',['objects/'+OID,'objects/'+OID]),('license-index-history-v2',['objects.zlib','extra'])]:
+   with self.subTest(fmt=fmt),self.assertRaises(ValueError):history_format(archive(fmt,names))
+ def test_manifest_bound(self):
+  with self.assertRaisesRegex(ValueError,'manifest exceeds'):history_format(archive('license-index-history-v2',['objects.zlib'],huge=True))
+ def test_no_history_is_not_a_format(self):
+  with self.assertRaises(Exception):history_format(b'')
+if __name__=='__main__':unittest.main(verbosity=2)
