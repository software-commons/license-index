+"""Scratch issuer-side v1/v2 preflight; no production configuration touched."""
+import os,sys,stat,subprocess,hashlib,json
+LAUNCHER_SHA='99d27d0d12706c6adb218c7973b18a0196e8e0076aca5850c57141d13f71f2da'
+PACKAGE_SHA='b7b5670537878161e2946a480b73160571be7b1e9e0664e6ad4be4b0836188e3'
+INTERPRETER_SHA='a92f0f95e883390c7256b2e441484aac06b1002dbe1d924141a77c8d82f96223'
+def root_chain(path):
+ if not os.path.isabs(path) or os.path.normpath(path)!=path:raise ValueError('path not canonical absolute')
+ fd=os.open('/',os.O_RDONLY|os.O_DIRECTORY|os.O_CLOEXEC)
+ try:
+  for part in [x for x in path.split('/') if x]:
+   n=os.open(part,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW|os.O_CLOEXEC,dir_fd=fd);os.close(fd);fd=n
+   s=os.fstat(fd)
+   if s.st_uid!=0:raise ValueError('ancestor not root-owned')
+   if s.st_mode&0o022 and not (part=='tmp' and s.st_mode&stat.S_ISVTX):raise ValueError('writable ancestor')
+  return fd
+ except:os.close(fd);raise
+def pinned_file(dfd,name,digest,maximum=1024*1024):
+ fd=os.open(name,os.O_RDONLY|os.O_NOFOLLOW|os.O_CLOEXEC,dir_fd=dfd)
+ try:
+  s=os.fstat(fd)
+  if not stat.S_ISREG(s.st_mode) or s.st_uid!=0 or s.st_mode&0o022 or s.st_nlink!=1 or s.st_size>maximum:raise ValueError('unsafe protected file')
+  b=b''
+  while len(b)<s.st_size:
+   part=os.read(fd,min(65536,s.st_size-len(b)))
+   if not part:raise ValueError('short protected read')
+   b+=part
+  if hashlib.sha256(b).hexdigest()!=digest:raise ValueError('protected digest')
+  os.lseek(fd,0,os.SEEK_SET);return fd,(s.st_dev,s.st_ino,s.st_size,s.st_mtime_ns)
+ except:os.close(fd);raise
+def preflight(owned,review_input,archive):
+ dfd=root_chain(owned); interpreter_dir=root_chain('/usr/bin'); launcher=package=interpreter=None
+ try:
+  launcher,launcher_identity=pinned_file(dfd,'isolated_history_launcher.py',LAUNCHER_SHA)
+  package,package_identity=pinned_file(dfd,'issuer_history_v2_pinned.py',PACKAGE_SHA)
+  interpreter,interpreter_identity=pinned_file(interpreter_dir,'python3.12',INTERPRETER_SHA,32*1024*1024)
+  result=subprocess.run([f'/proc/self/fd/{interpreter}','-I',f'/proc/self/fd/{launcher}',owned,review_input,archive],pass_fds=(launcher,interpreter),capture_output=True,timeout=130,check=False,env={'PATH':os.defpath})
+  if result.returncode:raise ValueError('trusted verifier failed: '+result.stderr.decode('utf-8','replace')[-1000:])
+  lines=result.stdout.decode().splitlines()
+  if len(lines)!=2 or not lines[0].startswith('history-proof 0 '):raise ValueError('invalid verifier result')
+  # Detect substitution even between root preflight and sandbox staging. The
+  # root-owned immutable ancestor chain prevents an unprivileged reviewer
+  # from renaming these inodes; repeat checks at review completion as well.
+  for name,expected,identity in [('isolated_history_launcher.py',LAUNCHER_SHA,launcher_identity),('issuer_history_v2_pinned.py',PACKAGE_SHA,package_identity)]:
+   check,now=pinned_file(dfd,name,expected);os.close(check)
+   if now!=identity:raise ValueError('protected inode changed')
+  check,now=pinned_file(interpreter_dir,'python3.12',INTERPRETER_SHA,32*1024*1024);os.close(check)
+  if now!=interpreter_identity:raise ValueError('interpreter inode changed')
+  out=json.loads(lines[1]);return {'preflight':'passed','launcher_sha256':LAUNCHER_SHA,'package_sha256':PACKAGE_SHA,'interpreter_sha256':INTERPRETER_SHA,'launcher_inode':launcher_identity,'package_inode':package_identity,'interpreter_inode':interpreter_identity,'history_proof':lines[0],'outcome':out}
+ finally:
+  if launcher is not None:os.close(launcher)
+  if package is not None:os.close(package)
+  if interpreter is not None:os.close(interpreter)
+  os.close(interpreter_dir)
+  os.close(dfd)
+def dispatch_after_preflight(owned,review_input,archive,launch):
+ # No review launch, verdict processing, or check issuance may occur after a
+ # failed preflight. A changed package/launcher after the review invalidates
+ # the trace before any caller can use it to issue a success check.
+ before=preflight(owned,review_input,archive)
+ trace=launch()
+ after=preflight(owned,review_input,archive)
+ for key in ('launcher_sha256','package_sha256','launcher_inode','package_inode','history_proof','outcome'):
+  if before[key]!=after[key]:raise ValueError('preflight binding changed')
+ return trace,before
+if __name__=='__main__':
+ if len(sys.argv)!=4:raise ValueError('usage: guarded_preflight directory input archive')
+ print(json.dumps(preflight(*sys.argv[1:]),sort_keys=True))
