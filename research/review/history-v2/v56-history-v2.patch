+"""Scratch-only v2 issuer preflight wiring; never enable without commissioning."""
+from pathlib import Path
+from io import BytesIO
+from zipfile import ZipFile
+from hashlib import sha256
+import json,os,re
+from .guarded_preflight import root_chain,pinned_file,preflight,LAUNCHER_SHA,PACKAGE_SHA
+from .review_protocol_v2 import validate_v2_history
+TOOL_ROOT=Path('/opt/software-commons-review/license-history-v2')
+FILES={'isolated_history_launcher.py':LAUNCHER_SHA,'issuer_history_v2_pinned.py':PACKAGE_SHA}
+def history_format(payload):
+ if len(payload)>16*1024*1024:raise ValueError('history archive exceeds limit')
+ with ZipFile(BytesIO(payload)) as z:
+  names=z.namelist()
+  if names.count('manifest.json')!=1:raise ValueError('invalid history manifest')
+  info=z.getinfo('manifest.json')
+  if info.file_size>8*1024*1024:raise ValueError('manifest exceeds limit')
+  manifest=json.loads(z.read(info))
+  if not isinstance(manifest,dict):raise ValueError('invalid history manifest')
+  result=manifest.get('format')
+  objects=manifest.get('objects')
+  if not isinstance(objects,dict) or not 0<len(objects)<=100000 or not all(isinstance(oid,str) and re.fullmatch('[0-9a-f]{40}',oid) for oid in objects):raise ValueError('invalid history object map')
+  if result=='license-index-history-v1':
+   if names!=['manifest.json',*[f'objects/{oid}' for oid in sorted(objects)]]:raise ValueError('invalid v1 history members')
+  elif result=='license-index-history-v2':
+   if names!=['manifest.json','objects.zlib']:raise ValueError('invalid v2 history members')
+ if result not in {'license-index-history-v1','license-index-history-v2'}:raise ValueError('unsupported history format')
+ return result
+
+def stage_v2_tools(input_dir,gid):
+ if os.geteuid()!=0:raise ValueError('root issuer required')
+ source=root_chain(str(TOOL_ROOT));parent=root_chain(str(input_dir));os.close(parent)
+ try:
+  blobs={}
+  for name,digest in FILES.items():
+   fd,_=pinned_file(source,name,digest)
+   try:
+    chunks=[]
+    while True:
+     chunk=os.read(fd,65536)
+     if not chunk:break
+     chunks.append(chunk)
+    blobs[name]=b''.join(chunks)
+    if sha256(blobs[name]).hexdigest()!=digest:raise ValueError('source changed')
+   finally:os.close(fd)
+ finally:os.close(source)
+ target=Path(input_dir)/'trusted';target.mkdir(mode=0o700)
+ for name,blob in blobs.items():
+  fd=os.open(target/name,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW|os.O_CLOEXEC,0o400)
+  with os.fdopen(fd,'wb') as f:f.write(blob);f.flush();os.fsync(f.fileno());os.fchown(f.fileno(),0,gid);os.fchmod(f.fileno(),0o440)
+ os.chown(target,0,gid);target.chmod(0o550)
+ return target
+
+def validate_after(trace,token,archive,base,head,before,after,input_dir):
+ return validate_v2_history(trace.decode('utf-8'),token,archive,base,head,before,after,input_dir)
